# GPT-Image2-Studio — 容器部署环境变量样例
#
#   cp deploy/env.example .env
#
# 这个文件被读两次：Compose 用它做 ${...} 插值，studio 容器拿它当应用配置。
# 它已在 .gitignore 里 —— 请保持，因为里面有密钥。
#
# ⚠️ 访问控制由前置 Traefik + Authentik 负责。
# 本 fork 已移除应用自身的鉴权，因此这里**没有** IMAGE_STUDIO_REQUEST_TOKEN，
# 也没有明文 HTTP 的开关。studio 只挂在 Traefik 的 docker 网络里、不发布端口；
# 没有 Authentik 认证，任何能到 Traefik 的人都能消耗你的 API 额度。

# === 容器接线 ============================================================
# 镜像 tag，由 `docker compose build` 打上。
STUDIO_TAG=0.3.001

# 容器与日志的时间区。
TZ=Asia/Shanghai

# === 上游供应商 ==========================================================
# 按你实际使用的通道填。这些变量在启动时读取，之后也可以在应用内的设置页改，
# 改动会持久化到 /data/.local/config.json。

# --- 路由模式（Responses API）---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
RESPONSES_MODEL=gpt-6-luna
IMAGE_TOOL_MODEL=gpt-image-2
IMAGE_QUALITY=high

# --- 直连模式（生图与文本分开配）---
DIRECT_IMAGE_BASE_URL=https://api.openai.com/v1
DIRECT_IMAGE_API_KEY=
DIRECT_IMAGE_ENDPOINT_PATH=images/generations
DIRECT_IMAGE_MODEL=gpt-image-2
DIRECT_TEXT_BASE_URL=https://api.openai.com/v1
DIRECT_TEXT_API_KEY=
DIRECT_TEXT_ENDPOINT_PATH=responses
DIRECT_TEXT_MODEL=gpt-6-luna

# --- xAI Grok 图像生成与编辑 ---
GROK_BASE_URL=https://api.x.ai/v1
GROK_API_KEY=
GROK_ENDPOINT_PATH=images/generations
GROK_IMAGE_MODEL=grok-imagine-image-2.0

# === 运行参数（一般不用改）==============================================
# 套图单项上游请求的最长时间，默认 1200000（20 分钟），范围 1000..3600000。
# 注意：Traefik 侧的读超时必须比它更长，否则代理会先断开连接
# （见 deploy/traefik-example.yml 的 studio-transport）。
IMAGE_STUDIO_CREATION_UPSTREAM_TIMEOUT_MS=1200000

# Docker 自带可用解析器，保持关闭应用内的公共 DNS 兜底。
IMAGE_STUDIO_DISABLE_DNS_FALLBACK=1

# HOST 与目录由 docker-compose.yml 统一设置，不要在这里覆盖成别的值：
#   HOST=0.0.0.0                        容器内必须监听全部接口
#   IMAGE_STUDIO_OUTPUT_DIR=/data/output
#   IMAGE_STUDIO_LOCAL_DATA_DIR=/data

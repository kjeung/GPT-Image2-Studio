OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
RESPONSES_MODEL=gpt-6-luna
# 路由模式的生图工具模型。仅接受 gpt-image-2、gpt-image-2.5-sunburst、
# gpt-image-2.5-flare；其他值会被收敛为 gpt-image-2。
IMAGE_TOOL_MODEL=gpt-image-2
# GPT 出图质量档。可选 low、medium、high、xhigh、max；xhigh 与 max 仅 2.5 模型支持，
# 在 gpt-image-2 上会自动降为 high。留空或非法值按 high 处理；Grok 固定使用 low/medium，默认 medium。
IMAGE_QUALITY=high

# Direct-call mode keeps image generation and text/vision providers separate.
DIRECT_IMAGE_BASE_URL=https://api.openai.com/v1
DIRECT_IMAGE_API_KEY=
DIRECT_IMAGE_ENDPOINT_PATH=images/generations
DIRECT_IMAGE_MODEL=gpt-image-2
DIRECT_TEXT_BASE_URL=https://api.openai.com/v1
DIRECT_TEXT_API_KEY=
DIRECT_TEXT_ENDPOINT_PATH=responses
DIRECT_TEXT_MODEL=gpt-6-luna

# xAI Grok Imagine image generation and editing.
GROK_BASE_URL=https://api.x.ai/v1
GROK_API_KEY=
GROK_ENDPOINT_PATH=images/generations
GROK_IMAGE_MODEL=grok-imagine-image-2.0

# Legacy direct variables remain accepted as a migration fallback. Prefer the
# channel-specific DIRECT_IMAGE_* and DIRECT_TEXT_* variables above.
# DIRECT_BASE_URL=
# DIRECT_API_KEY=
# DIRECT_ENDPOINT_PATH=
# DIRECT_RESPONSES_MODEL=

# 容器部署必须设为 0.0.0.0：容器内只监听 127.0.0.1 时，宿主端口映射接不进来。
# 直接在本机跑 Node（不经容器）时留空即可，仍只监听回环。
HOST=
# 本 fork 的访问控制由前置 Traefik + Authentik 负责，应用自身不再鉴权，
# 因此不再需要 IMAGE_STUDIO_REQUEST_TOKEN 与 IMAGE_STUDIO_ALLOW_INSECURE_REMOTE_HTTP。
# 那两个变量即使设置也不再参与访问决策，保留它们只为兼容旧部署文件。

# Local Node DNS fallback is enabled by default with 223.5.5.5 and 1.1.1.1.
# Set to 1 to keep Node's original DNS resolver list untouched.
IMAGE_STUDIO_DISABLE_DNS_FALLBACK=0
# Optional. Separate custom resolver IPs with commas, semicolons, or spaces.
IMAGE_STUDIO_DNS_FALLBACK_SERVERS=

# 套图单项上游请求的最长时间，默认 1200000（20 分钟）。
# 有效范围为 1000 到 3600000，超出会被收敛到边界。
IMAGE_STUDIO_CREATION_UPSTREAM_TIMEOUT_MS=1200000
# 仅测试用途。必须与 IMAGE_STUDIO_MOCK_IMAGE_GENERATION=1、IMAGE_STUDIO_OUTPUT_DIR
# 和 IMAGE_STUDIO_LOCAL_DATA_DIR 同时设置才会启用本地假图；缺一即忽略并打印告警。
# 正式运行请保持注释状态。
# IMAGE_STUDIO_ENABLE_TEST_MOCKS=0

# === 生图默认值（四通道共用）============================================
# 尺寸与格式对所有通道同时生效；思考等级只影响文本/视觉调用。
# 格式默认 jpg：体积远小于 png，生成与回传都更快。透明背景仍会自动用 png。
IMAGE_SIZE=1024x1280
IMAGE_FORMAT=jpg
REASONING_EFFORT=high
# 批量生成节奏：延迟 200..5000 毫秒，并发 1..50。
GENERATION_START_DELAY_MS=1000
GENERATION_CONCURRENCY=20
# 路由选择：a=Responses 路由、b=直连、c=模型协议、d=Grok。留空按 a。
IMAGE_ROUTE=a
# 是否在 tools[] 里带 model 字段：0 关、1 开。
IMAGE_TOOL_MODEL_INCLUDE=0
# 直连模式是否用流式响应：0 关、1 开。
DIRECT_IMAGE_STREAM=0

# === 容器部署 / Traefik 接线 ==============================================
# 下面这些只有用 compose.yml + start.sh 部署时才需要；直接跑 node 可忽略。

# 镜像 tag，由 docker compose build 打上，对应 package.json 的版本号。
STUDIO_TAG=0.3.001

# 数据目录（宿主机路径）。start.sh 会建好并检查属主；
# 容器内固定挂在 /data。备份时直接复制这个目录即可。
DATA_DIR=./data

# 容器名与 compose 项目名（两者必须一致），同时是 traefik_net 内的 DNS 别名，
# Traefik 靠它回源，start.sh 也用它做版本核对。
#
# 想接管一套已存在的部署（例如机器上已经有个 aeboli-gpt-image2-studio 在跑），
# 把它改成那个名字即可：compose 会以同一个项目名接管，Traefik 路由不用动。
# 改名前先停掉旧的，否则同名冲突：
#   docker stop <旧容器> && docker rm <旧容器>
STUDIO_CONTAINER_NAME=gpt-image2-studio

# 容器内部监听的端口，默认 3600。改了也要同步 traefik-dynamic.yml 的 service url。
STUDIO_INTERNAL_PORT=3600

# 外部 Traefik 网络名。本仓库不创建它，需事先存在：
#   docker network create traefik_net
TRAEFIK_NET=traefik_net

# --- 以下四项由 start.sh 渲染进 traefik-dynamic.yml，缺任一项会拒绝启动 ---

# 对外访问的域名。写真实域名，它只留在本机 .env 与渲染产物里，不会进版本库。
STUDIO_DOMAIN=studio.example.com

# Traefik 的入口点名称，通常 https 是 websecure、http 是 web。
TRAEFIK_ENTRYPOINT=websecure

# Traefik 的证书解析器名称（对应你 Traefik 静态配置里的 certResolver）。
TRAEFIK_CERT_RESOLVER=le

# Authentik 的 forwardAuth 地址。通常形如：
#   http://<authentik 主机>:9000/outpost.goauthentik.io/auth/traefik
AUTHENTIK_FORWARD_AUTH_URL=

# 本地时区。
TZ=Asia/Shanghai

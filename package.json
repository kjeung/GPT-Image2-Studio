{
  "name": "gpt-image2-studio",
  "version": "0.2.116",
  "private": true,
  "type": "module",
  "description": "本地优先的 AI 图像生成与视觉创作工作台",
  "author": "aEboli",
  "scripts": {
    "start": "node server.mjs",
    "dev": "node server.mjs",
    "generate": "node generate-image.mjs",
    "help": "node generate-image.mjs --help",
    "import:youmind": "node scripts/import-youmind-prompt-library.mjs",
    "sync:public-lib": "node scripts/sync-public-lib.mjs",
    "build:extension": "node scripts/build-product-image-extension.mjs",
    "build:installer": "node scripts/build-windows-installer.mjs",
    "release:major": "node scripts/release-patch.mjs --type major",
    "release:minor": "node scripts/release-patch.mjs --type minor",
    "release:feature": "node scripts/release-patch.mjs --type feature",
    "release:patch": "node scripts/release-patch.mjs --type patch",
    "check:release": "node scripts/check-release-readiness.mjs",
    "check:release:strict": "node scripts/check-release-readiness.mjs --strict",
    "verify:ci": "node scripts/verify-ci-gates.mjs",
    "test": "node --test --test-concurrency=1 ./test/*.test.mjs",
    "test:creation-e2e": "node --test ./test/creation-e2e-regression.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@jsquash/webp": "1.5.0",
    "exceljs": "4.4.0",
    "jimp": "1.6.1",
    "jszip": "^3.10.1",
    "morphicons": "1.7.1",
    "pptxgenjs": "^4.0.1"
  },
  "overrides": {
    "pptxgenjs": {
      "image-size": "2.0.4"
    },
    "exceljs": {
      "uuid": "11.1.1"
    }
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.6.0",
    "lucide-static": "1.37.0",
    "parse5": "8.0.1"
  }
}
